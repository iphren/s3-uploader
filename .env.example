# Defaults read by generate_upload_link.py. CLI flags override these.
S3_BUCKET=my-upload-bucket
AWS_REGION=eu-west-2
PAGE_URL=https://upload.example.com

# Optional: select a named profile from ~/.aws/credentials
# AWS_PROFILE=default

# Optional: for buckets served behind the page's own CloudFront
# distribution (see README "Make link configs readable")
# LINKS_PREFIX=web/links
# SAME_ORIGIN_LINKS=1

# Optional: used by deploy.sh when hosting the page in the bucket itself
# WEB_PREFIX=web
# CLOUDFRONT_DISTRIBUTION_ID=E1A2B3C4D5E6F7
